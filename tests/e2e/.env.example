# Copy to tests/e2e/.env for manual runs.
# `bin/setup-docker.sh` writes this file for you against the Docker stack.
# In CI these are provided by the GitHub Actions job environment.

# Site under test (Docker stack default).
BASE_URL=http://localhost:8888

# WP admin credentials — used for the UI login + saved session, and (via the
# WP-API Basic-Auth plugin) for the API project's HTTP Basic auth.
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=password

# REST auth user (defaults to WP_ADMIN_USER).
WP_API_USER=admin

# Optional: a WP Application Password. If set, it OVERRIDES WP_ADMIN_PASSWORD for
# the API project (use against sites without the Basic-Auth plugin). Spaces are
# part of the value — keep it quoted/unmodified.
# WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Optional: StoreGrowth Pro license key (Appsero). When set AND the Pro plugin is
# mounted, provisioning activates it so Pro features/tests run. Leave empty for
# lite-only. (The Docker stack mounts the sibling Pro plugin automatically.)
# LICENSE_KEY=your-pro-license-key
