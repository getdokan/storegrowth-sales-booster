# Copy to tests/e2e/.env and fill in for local runs.
# In CI these are provided by the GitHub Actions job environment.

# Site under test.
BASE_URL=http://localhost:8888

# WP admin credentials — used for the UI login and the saved session.
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=password

# REST/API auth via a WP Application Password
# (Users -> Profile -> Application Passwords). Spaces are part of the value.
WP_API_USER=admin
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
