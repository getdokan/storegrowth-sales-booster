{
  "name": "storegrowth-sales-booster",
  "version": "2.2.0",
  "description": "StoreGrowth - Sales Booster for WooCommerce",
  "author": "Dokan Inc.",
  "license": "GPL-2.0-or-later",
  "private": true,
  "scripts": {
    "start": "wp-scripts start --progress",
    "start:hot": "wp-scripts start --progress --hot",
    "build": "wp-scripts build --progress",
    "type-check": "tsc --noEmit",
    "lint:js": "wp-scripts lint-js src modules/*/src integrations/src",
    "lint:css": "wp-scripts lint-style 'src/**/*.css'",
    "format": "wp-scripts format src modules/*/src integrations/src",
    "check:hooks": "bash bin/check-hook-baseline.sh",
    "archiver": "node bin/archiver.mjs",
    "version": "bash bin/version-replace.sh",
    "makepot": "wp i18n make-pot --domain='storegrowth-sales-booster' --include='assets/src,build,includes,lib,modules,integrations,storegrowth-sales-booster.php' . --headers='{\"Report-Msgid-Bugs-To\":\"https://storegrowth.io/contact-us/\"}' --file-comment=\"Copyright (c) $(date +'%Y') All Rights Reserved by weDevs.\" languages/storegrowth-sales-booster.pot",
    "release": "composer i --no-dev -o && npm i && npm run type-check && npm run build && npm run version && npm run makepot && npm run archiver",
    "test": "npm run phpunit",
    "phpunit": "vendor/bin/phpunit -c phpunit.xml",
    "phpunit:env": "wp-env run tests-cli --env-cwd=wp-content/plugins/storegrowth-sales-booster vendor/bin/phpunit -c phpunit.xml",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:destroy": "wp-env destroy"
  },
  "dependencies": {
    "@wedevs/plugin-ui": "github:getdokan/plugin-ui#45dd41355d5146fd066053079aa6b2d4ec992969",
    "@wordpress/api-fetch": "^7.32.0",
    "@wordpress/dom-ready": "^4.32.0",
    "@wordpress/element": "^6.32.0",
    "@wordpress/hooks": "^4.32.0",
    "@wordpress/i18n": "^6.5.0",
    "@wordpress/url": "^4.32.0",
    "lucide-react": "^0.563.0"
  },
    "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@wordpress/dependency-extraction-webpack-plugin": "^6.32.0",
    "@wordpress/scripts": "^30.25.0",
    "archiver": "^6.0.1",
    "colorette": "^2.0.20",
    "eslint-plugin-check-file": "^2.8.0",
    "jszip": "^3.10.1",
    "mini-css-extract-plugin": "^2.9.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0"
  }
}
