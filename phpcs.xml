<?xml version="1.0"?>
<ruleset name="WordPress Plugin Coding Standards">

    <description>WordPress Plugin PHP_CodeSniffer ruleset.</description>

    <!-- Exclude paths -->
    <exclude-pattern>bin/*</exclude-pattern>
    <exclude-pattern>lib/*</exclude-pattern>
    <exclude-pattern>assets/*</exclude-pattern>

    <!-- Exclude module assets -->
    <exclude-pattern>modules/fly-cart/assets/*</exclude-pattern>
    <exclude-pattern>modules/progressive-discount-banner/assets/*</exclude-pattern>
    <exclude-pattern>modules/sales-pop/assets/*</exclude-pattern>
    <exclude-pattern>modules/countdown-timer/assets/*</exclude-pattern>
    <exclude-pattern>modules/direct-checkout/assets/*</exclude-pattern>
    <exclude-pattern>modules/upsell-order-bump/assets/*</exclude-pattern>
    <!-- Configs -->
    <config name="minimum_supported_wp_version" value="5.0" />
    <config name="testVersion" value="7.4-"/>

    <arg name="basepath" value="."/>

    <!-- Rules -->
    <rule ref="WordPress">
        <!-- The plugin autoloads PSR-4 (StorePulse\StoreGrowth\ => PascalCase
             filenames), so the WordPress lowercase-hyphen / class- filename
             convention does not apply and the whole tree already diverges. -->
        <exclude name="WordPress.Files.FileName" />
    </rule>

    <rule ref="PHPCompatibilityWP" />

    <rule ref="WooCommerce-Core">
        <!-- The SPSG_VERSION placeholder is a required convention (see CLAUDE.md);
             it is swapped for a real version at release by bin/version-replace.sh.
             This sniff rejects the placeholder, so exclude it. -->
        <exclude name="WooCommerce.Commenting.CommentHooks.MissingSinceVersionComment" />
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array" value="storegrowth-sales-booster" />
        </properties>
    </rule>
</ruleset>
